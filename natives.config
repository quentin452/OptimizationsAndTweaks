# natives.config — consumed by the SHARED build_natives.sh
# (../../matoulib/matoulib_native_shared/tools/build_natives.sh). Sourced as bash.
MODID="optimizationsandtweaks"
# cdylib crates that ship a native. rlib-only crates are NOT listed:
#   optimizationsandtweaks_profiler is rlib-only (intentionally not shipped).
CRATES=(
  optimizationsandtweaks_shared
  optimizationsandtweaks_pathfinding
  optimizationsandtweaks_blocksupdates
)
# Build the standalone gnu-ABI windows .dll too (1=yes).
INCLUDE_WINDOWS=1
